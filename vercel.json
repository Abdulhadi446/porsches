{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci",
  "devCommand": "next dev --port $PORT",
  "buildCommand": "npm run deploy:build:switch",
  "headers": [
    {
      "source": "/turntables/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}