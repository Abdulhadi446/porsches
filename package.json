{
  "name": "porsche-911-showcase",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "merge:assets": "node scripts/merge-assets.ts",
    "assets:images": "node scripts/fetch-images.ts --all && node scripts/convert-images.ts",
    "assets:images:verify": "node scripts/convert-images.ts --verify",
    "assets:models": "node scripts/fetch-models.ts",
    "prebuild": "node scripts/merge-assets.ts && node scripts/build-client-catalog.ts",
    "predev": "node scripts/merge-assets.ts && node scripts/build-client-catalog.ts",
    "catalog": "node scripts/build-client-catalog.ts",
    "deploy:build": "node scripts/merge-assets.ts && node scripts/build-client-catalog.ts && next build",
    "deploy:build:assets": "node scripts/fetch-images.ts --all && node scripts/convert-images.ts && node scripts/fetch-turntables.ts --all && node scripts/merge-assets.ts && node scripts/build-client-catalog.ts && next build",
    "deploy:build:switch": "if [ \"${P911_FETCH_ASSETS:-0}\" = \"1\" ]; then npm run deploy:build:assets; else npm run deploy:build; fi",
    "deploy:check": "node scripts/merge-assets.ts --check && tsc --noEmit && eslint .",
    "ci:assets": "node scripts/fetch-images.ts --all && node scripts/convert-images.ts && node scripts/fetch-turntables.ts --all && node scripts/merge-assets.ts && node scripts/build-client-catalog.ts",
    "assets:turntables": "node scripts/fetch-turntables.ts"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "lighthouse": "^13.5.0",
    "playwright": "^1.63.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/postprocessing": "^3.1.3",
    "framer-motion": "^13.4.6",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  }
}
